# Builds the working tree this file sits in:   cd packaging && makepkg -si
pkgname=snowhush
pkgver=0.1.0
pkgrel=1
pkgdesc="Snow, leaves, blossom, rain and flowers on your Hyprland desktop, with a tray icon and a GTK4 controller"
arch=('x86_64' 'aarch64')
url="https://github.com/tak0dan/snowhush-linux"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'libglvnd' 'wayland' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('ttf-jetbrains-mono: pixel-theme font fallback'
            'ttf-press-start-2p: authentic pixel font for the controller in pixel mode')
options=('!lto')

prepare() {
  cd "$startdir/.."
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu" 2>/dev/null || cargo fetch --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$startdir/.."
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --frozen 2>/dev/null || cargo build --release
}

check() {
  cd "$startdir/.."
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --release -p snowhush-core
}

package() {
  cd "$startdir/.."
  for b in snowhushd snowhushctl snowhush-gui; do
    install -Dm755 "$srcdir/target/release/$b" "$pkgdir/usr/bin/$b"
  done
  install -Dm644 packaging/snowhush-controller.desktop "$pkgdir/usr/share/applications/io.github.snowhush.Controller.desktop"
  install -Dm644 packaging/snowhush.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/snowhush.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/snowhushd.service "$pkgdir/usr/lib/systemd/user/snowhushd.service"
}
